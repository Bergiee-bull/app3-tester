# Public OneSignal App ID goes in data/push_config.json after the OneSignal Web app is created.
APP3_PUSH_NOTIFICATIONS_ENABLED=false
APP3_PUSH_ALLOW_TEST=false
ONESIGNAL_APP_ID=replace_with_public_onesignal_app_id
ONESIGNAL_REST_API_KEY=replace_with_private_onesignal_rest_api_key
# Optional; default is outside the repository under ~/Library/Application Support/App3 Tester/.
# APP3_PUSH_STATE_FILE=/Users/you/Library/Application Support/App3 Tester/push_notification_state.json
